# Production settings. Copy to .env and fill in. Never commit .env.

# Your address, without https:// (e.g. docsign.duckdns.org or sign.nuronixai.in)
DOMAIN=

# Long random secrets: generate each with   openssl rand -hex 32
APP_SECRET=
POSTGRES_PASSWORD=
S3_SECRET_KEY=

# Where data lives (label shown in the app; keep "in" for India)
CELL_REGION=in

# --- Email (free: Brevo, 300 emails/day) ---------------------------------
# brevo.com → SMTP & API → SMTP: use the login and an SMTP key as the password
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be a sender you verified in Brevo
MAIL_FROM="DocSign <no-reply@your-domain.com>"
SUPPORT_EMAIL=support@your-domain.com

# --- Staff who can open the platform console (/admin) ----------------------
PLATFORM_ADMINS=

# --- Optional -------------------------------------------------------------
# Virus scanning: start with --profile scan, then set CLAMAV_HOST=clamav
CLAMAV_HOST=
# Trusted timestamps on signed PDFs
TSA_URL=http://timestamp.digicert.com
# AI features (contract review, summaries): an Anthropic API key
ANTHROPIC_API_KEY=
