{
  "name": "@docsign/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker-main.ts",
    "start:worker": "node dist/worker-main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.6.0",
    "@signpdf/placeholder-pdf-lib": "^3.2.4",
    "@signpdf/signpdf": "^3.2.4",
    "@signpdf/utils": "^3.2.4",
    "@xmldom/xmldom": "^0.9.12",
    "asn1js": "^3.0.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fflate": "^0.8.3",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.10.0",
    "openid-client": "^6.8.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pino": "^10.4.0",
    "pkijs": "^3.2.4",
    "pngjs": "^7.0.0",
    "xml-crypto": "^6.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pngjs": "^6.0.5",
    "oauth2-mock-server": "^9.3.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
