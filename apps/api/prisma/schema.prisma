generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model Organization {
  id           String            @id @default(cuid())
  name         String
  // Default jurisdiction applied to new envelopes (US, UK, EU, IN ...)
  jurisdiction String            @default("US")
  // Regional cell that owns this tenant's data
  dataRegion   String
  // Branding on emails and the signing page
  brandColor   String?
  logoKey      String?
  // Origins allowed to frame embedded signing (e.g. https://app.example.com)
  embedOrigins String[]          @default([])
  createdAt    DateTime          @default(now())
  users        User[]
  envelopes    Envelope[]
  apiKeys      ApiKey[]
  webhooks     WebhookEndpoint[]
  templates    Template[]
  invitations  Invitation[]
  folders      Folder[]
  activity     ActivityLog[]
  forms        SigningForm[]
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         UserRole     @default(MEMBER)
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions     Session[]
  envelopes    Envelope[]
  // Deactivated users can't sign in; their envelopes stay with the organisation
  disabledAt   DateTime?
  createdAt    DateTime     @default(now())
}

model Invitation {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole     @default(MEMBER)
  tokenHash   String       @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([orgId])
}

model Folder {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  envelopes Envelope[]

  @@unique([orgId, name])
}

// Organisation-level admin events (users, keys, branding, settings)
model ActivityLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type      String
  actor     Json
  data      Json
  ip        String?
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  // First characters of the key, shown in the UI so users can tell keys apart
  prefix     String
  keyHash    String       @unique
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

// ---------------------------------------------------------------------------
// Agreements
// ---------------------------------------------------------------------------

enum EnvelopeStatus {
  DRAFT
  SENT
  COMPLETED
  DECLINED
  VOIDED
  EXPIRED
}

enum RoutingMode {
  SEQUENTIAL
  PARALLEL
}

model Envelope {
  id                String         @id @default(cuid())
  orgId             String
  org               Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User           @relation(fields: [createdById], references: [id])
  title             String
  message           String?
  status            EnvelopeStatus @default(DRAFT)
  routing           RoutingMode    @default(SEQUENTIAL)
  jurisdiction      String
  documentType      String         @default("general")
  folderId          String?
  folder            Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Set when created through a self-serve signing form
  formId            String?
  // e-Stamp request (state, article, duty, parties) and the issued certificate
  estamp            Json?
  estampResult      Json?
  // Snapshot of the resolved compliance profile at send time
  policy            Json?
  reminderDays      Int            @default(2)
  expiresAt         DateTime?
  sentAt            DateTime?
  completedAt       DateTime?
  // Claim marker so only one worker seals a fully signed envelope; stale claims are retried
  finalizingAt      DateTime?
  voidReason        String?
  certificateKey    String?
  certificateSha256 String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  documents         Document[]
  recipients        Recipient[]
  fields            Field[]
  auditEvents       AuditEvent[]

  @@index([orgId, status])
}

model Document {
  id          String   @id @default(cuid())
  envelopeId  String
  envelope    Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name        String
  order       Int      @default(0)
  // Original (converted) PDF
  storageKey  String
  sha256      String
  pageCount   Int
  // [{ width, height }] in PDF points, used by the field editor
  pages       Json
  // Completed, sealed PDF
  // Copy that signer signatures are appended to (incremental updates); AES envelopes only
  workingKey  String?
  finalKey    String?
  finalSha256 String?
  createdAt   DateTime @default(now())
  fields      Field[]

  @@index([finalSha256])
}

enum RecipientRole {
  SIGNER
  // Reviews and approves without filling fields
  APPROVER
  CC
}

enum SignatureMethod {
  // Electronic signature (SES) sealed by the platform
  ELECTRONIC
  // Aadhaar eSign through a licensed eSign Service Provider (India, AES)
  AADHAAR_ESIGN
  // Signer's own Digital Signature Certificate on a USB token (AES)
  DSC
}

enum AuthMethod {
  EMAIL_OTP
  SMS_OTP
  WHATSAPP_OTP
  // Code shared with the signer out of band by the sender
  ACCESS_CODE
  // Identity established by the integrating app (embedded signing) or a host (in person)
  NONE
}

enum RecipientStatus {
  CREATED
  SENT
  VIEWED
  SIGNED
  DECLINED
}

model Recipient {
  id                   String          @id @default(cuid())
  envelopeId           String
  envelope             Envelope        @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name                 String
  email                String
  role                 RecipientRole   @default(SIGNER)
  routingOrder         Int             @default(1)
  // Language for emails and the signing page (BCP 47 code, e.g. "hi", "es")
  locale               String          @default("en")
  authMethod           AuthMethod      @default(EMAIL_OTP)
  signatureMethod      SignatureMethod @default(ELECTRONIC)
  // E.164 phone number for SMS / WhatsApp codes
  phone                String?
  accessCodeHash       String?
  // Embedded recipients sign inside the integrator's app; no emails are sent
  embedded             Boolean         @default(false)
  clientUserId         String?
  // In-person signing hosted by a user of the sending organisation
  hostUserId           String?
  // Bumped when the recipient is corrected or reassigned, invalidating old links
  tokenVersion         Int             @default(0)
  // One-time ticket that starts an embedded signing session (hashed, short-lived)
  embedTicketHash      String?         @unique
  embedTicketExpiresAt DateTime?
  embedReturnUrl       String?
  status               RecipientStatus @default(CREATED)
  // One-time passcode for signer authentication (hashed)
  otpHash              String?
  otpExpiresAt         DateTime?
  otpAttempts          Int             @default(0)
  // Set after OTP verification; ties the signing session to one browser
  signerSessionHash    String?
  verifiedAt           DateTime?
  viewedAt             DateTime?
  signedAt             DateTime?
  declinedAt           DateTime?
  declineReason        String?
  lastNotifiedAt       DateTime?
  signedIp             String?
  signedUserAgent      String?
  fields               Field[]

  @@index([envelopeId])
}

enum FieldType {
  SIGNATURE
  INITIALS
  DATE_SIGNED
  NAME
  EMAIL
  TEXT
  CHECKBOX
  DROPDOWN
  RADIO
  NUMBER
  // Read-only value computed from NUMBER fields, e.g. "{Qty} * {Price}"
  FORMULA
  // Signer uploads a supporting file
  ATTACHMENT
}

model Field {
  id          String    @id @default(cuid())
  envelopeId  String
  envelope    Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        FieldType
  // 0-based page index; position and size are fractions (0..1) of the page,
  // measured from the top-left corner.
  page        Int
  x           Float
  y           Float
  width       Float
  height      Float
  required    Boolean   @default(true)
  label       String?
  // Choices for DROPDOWN / RADIO
  options     String[]  @default([])
  // Expression for FORMULA fields, referencing NUMBER fields by label: "{Qty} * {Price}"
  formula     String?
  // Show this field only when another field has a value: { "fieldLabel": "Has guarantor", "equals": "true" }
  condition   Json?
  // Filled in by the signer. Signatures/initials are PNG data URLs.
  value       String?

  @@index([envelopeId])
}

// ---------------------------------------------------------------------------
// Evidence
// ---------------------------------------------------------------------------

// Append-only, hash-chained log. hash = SHA-256(prevHash || canonical(event)).
model AuditEvent {
  id         String   @id @default(cuid())
  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  seq        Int
  type       String
  actor      Json
  data       Json
  ip         String?
  userAgent  String?
  createdAt  DateTime
  prevHash   String
  hash       String

  @@unique([envelopeId, seq])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model WebhookEndpoint {
  id         String            @id @default(cuid())
  orgId      String
  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  // Empty = all events
  events     String[]
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// Transactional outbox: rows are written in the same transaction as the
// state change, then delivered by the worker with retries.
model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        DeliveryStatus  @default(PENDING)
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastError     String?
  responseCode  Int?
  deliveredAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

// A reusable envelope: documents, placeholder roles and field layout.
// Recipients are bound to roles when an envelope is created from it.
model Template {
  id           String             @id @default(cuid())
  orgId        String
  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdById  String
  name         String
  description  String?
  title        String
  message      String?
  jurisdiction String
  documentType String             @default("general")
  routing      RoutingMode        @default(SEQUENTIAL)
  reminderDays Int                @default(2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  documents    TemplateDocument[]
  roles        TemplateRole[]
  fields       TemplateField[]

  @@index([orgId])
}

model TemplateDocument {
  id         String          @id @default(cuid())
  templateId String
  template   Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int             @default(0)
  storageKey String
  sha256     String
  pageCount  Int
  pages      Json
  fields     TemplateField[]
}

model TemplateRole {
  id           String          @id @default(cuid())
  templateId   String
  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // e.g. "Employee", "Manager"
  name         String
  role         RecipientRole   @default(SIGNER)
  routingOrder Int             @default(1)
  fields       TemplateField[]
}

model TemplateField {
  id         String           @id @default(cuid())
  templateId String
  template   Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documentId String
  document   TemplateDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  roleId     String
  role       TemplateRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  type       FieldType
  page       Int
  x          Float
  y          Float
  width      Float
  height     Float
  required   Boolean          @default(true)
  label      String?
  options    String[]         @default([])
  formula    String?
  condition  Json?
}

// ---------------------------------------------------------------------------
// Website
// ---------------------------------------------------------------------------

// Demo / contact requests from the public website
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  role      String?
  country   String?
  interest  String
  message   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Files uploaded by signers through ATTACHMENT fields
model SignerAttachment {
  id          String   @id @default(cuid())
  envelopeId  String
  fieldId     String
  recipientId String
  name        String
  contentType String
  size        Int
  sha256      String
  storageKey  String
  createdAt   DateTime @default(now())

  @@index([envelopeId])
}

// Self-serve signing link: anyone with the link can sign a copy of a template
model SigningForm {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId String
  name       String
  slug       String       @unique
  active     Boolean      @default(true)
  maxUses    Int?
  uses       Int          @default(0)
  createdAt  DateTime     @default(now())
}

// One Aadhaar eSign / DSC request awaiting the signer's authentication
model EsignTransaction {
  id          String    @id
  envelopeId  String
  recipientId String
  provider    String
  status      String    @default("PENDING")
  // [{ documentId, preparedKey, contentsStart, contentsEnd, digest }]
  documents   Json
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([recipientId])
}
