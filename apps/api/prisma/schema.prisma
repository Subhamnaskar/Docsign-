generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model Organization {
  id                 String            @id @default(cuid())
  name               String
  // Default jurisdiction applied to new envelopes (US, UK, EU, IN ...)
  jurisdiction       String            @default("US")
  // Regional cell that owns this tenant's data
  dataRegion         String
  // Branding on emails and the signing page
  brandColor         String?
  logoKey            String?
  // Origins allowed to frame embedded signing (e.g. https://app.example.com)
  embedOrigins       String[]          @default([])
  // Single sign-on (OpenID Connect)
  ssoIssuer          String?
  ssoClientId        String?
  ssoClientSecretEnc String?
  // Email domains that sign in through this organisation's identity provider
  ssoDomains         String[]          @default([])
  // Password sign-in is turned off for these domains (owners keep a fallback)
  ssoEnforced        Boolean           @default(false)
  ssoDefaultRole     UserRole          @default(MEMBER)
  // SCIM provisioning bearer token (hashed)
  scimTokenHash      String?           @unique
  // AI features send document content to the model provider; admins opt in
  aiEnabled          Boolean           @default(false)
  // Every password user must turn on two-factor authentication
  require2fa         Boolean           @default(false)
  // Internal approval before sending: off | members (agreements from members) | all
  approvalPolicy     String            @default("off")
  // Who may approve; empty = any owner or admin
  approverIds        String[]          @default([])
  // --- Data governance ---
  // Delete completed agreements this many days after completion (never before the legal retention); null = keep
  retentionDays      Int?
  // Delete drafts, voided, declined and expired agreements after this many days; null = keep
  purgeIncompleteDays Int?
  // --- Access ---
  // CIDR ranges allowed to use the app and API (empty = anywhere)
  ipAllowlist        String[]          @default([])
  // --- Email from the customer's domain (DKIM-signed) ---
  emailFromName      String?
  emailReplyTo       String?
  emailDomain        String?
  dkimSelector       String?
  dkimPrivateKeyEnc  String?
  dkimPublicKey      String?
  emailDomainVerifiedAt DateTime?
  // --- Signing pages on the customer's own domain (e.g. sign.example.com) ---
  customDomain       String?           @unique
  customDomainToken  String?
  customDomainVerifiedAt DateTime?
  // --- Customer-managed key for documents at rest (S3 SSE-KMS key ARN) ---
  storageKmsKeyId    String?
  // --- Billing (see src/billing/plans.ts) ---
  plan               String            @default("trial")
  billingStatus      BillingStatus     @default(TRIALING)
  trialEndsAt        DateTime          @default(dbgenerated("(now() + '14 days'::interval)"))
  seats              Int               @default(5)
  // month | year
  billingInterval    String            @default("month")
  billingCurrency    String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean           @default(false)
  billingProvider    String?
  // Subscription id at the provider (Stripe sub_..., Razorpay sub_...)
  subscriptionRef    String?           @unique
  // --- Platform console (NuronixAI staff) ---
  // Suspended organisations can't sign in, use the API or open signing links
  suspendedAt        DateTime?
  suspendedReason    String?
  // The customer lets NuronixAI support view the account (read-only) until then
  supportAccessUntil DateTime?
  creditNotes        CreditNote[]
  // Printed on invoices
  billingName        String?
  billingEmail       String?
  billingAddress     String?
  // GSTIN (India) or VAT number
  taxId              String?
  createdAt          DateTime          @default(now())
  users              User[]
  departments        Department[]
  crmConnections     CrmConnection[]
  envelopes          Envelope[]
  apiKeys            ApiKey[]
  webhooks           WebhookEndpoint[]
  templates          Template[]
  docTemplates       DocTemplate[]
  invitations        Invitation[]
  folders            Folder[]
  activity           ActivityLog[]
  forms              SigningForm[]
  invoices           Invoice[]
  billingCheckouts   BillingCheckout[]
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         UserRole     @default(MEMBER)
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions     Session[]
  envelopes    Envelope[]
  // Deactivated users can't sign in; their envelopes stay with the organisation
  disabledAt   DateTime?
  // Identity-provider subject and SCIM externalId, when provisioned that way
  ssoSubject   String?
  externalId   String?
  // Senders confirm their email before sending; invited and SSO users are verified on creation
  emailVerifiedAt    DateTime?
  // Two-factor authentication (TOTP), secrets sealed with lib/secretbox
  totpSecretEnc      String?
  totpPendingEnc     String?
  totpEnabledAt      DateTime?
  // Hashed single-use recovery codes
  recoveryCodeHashes String[]     @default([])
  authTokens   AuthToken[]
  loginEvents  LoginEvent[]
  // Last successful sign-in (any method), for the platform console
  lastLoginAt  DateTime?
  // Getting-started checklist hidden by the user
  onboardingDismissedAt DateTime?
  // Language of the app for this user (BCP 47, e.g. "hi")
  locale       String       @default("en")
  departments  DepartmentMember[]
  createdAt    DateTime     @default(now())
}

/// Single-use tokens for email verification, password reset and the second login step.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
  MFA_LOGIN
}

model Invitation {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole     @default(MEMBER)
  tokenHash   String       @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([orgId])
}

model Folder {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  envelopes Envelope[]

  @@unique([orgId, name])
}

// Organisation-level admin events (users, keys, branding, settings)
model ActivityLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type      String
  actor     Json
  data      Json
  ip        String?
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip         String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  // Read-only support session started from the platform console by this staff member
  impersonatorUserId String?
  impersonatorEmail  String?
}

model ApiKey {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  // First characters of the key, shown in the UI so users can tell keys apart
  prefix     String
  keyHash    String       @unique
  // live | test (test keys create watermarked test agreements that are not billed)
  mode       String       @default("live")
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

// ---------------------------------------------------------------------------
// Agreements
// ---------------------------------------------------------------------------

enum EnvelopeStatus {
  DRAFT
  SENT
  COMPLETED
  DECLINED
  VOIDED
  EXPIRED
}

enum RoutingMode {
  SEQUENTIAL
  PARALLEL
}

model Envelope {
  id                String         @id @default(cuid())
  orgId             String
  org               Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User           @relation(fields: [createdById], references: [id])
  title             String
  message           String?
  status            EnvelopeStatus @default(DRAFT)
  routing           RoutingMode    @default(SEQUENTIAL)
  jurisdiction      String
  documentType      String         @default("general")
  // Created with a test API key: watermarked, not legally binding, not billed
  testMode          Boolean        @default(false)
  // Links to records in connected systems, e.g. { "hubspotDealId": "123", "salesforceRecordId": "006…" }
  externalRefs      Json?
  departmentId      String?
  department        Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Legal hold: never deleted by retention rules while set
  legalHoldAt       DateTime?
  legalHoldReason   String?
  legalHoldBy       String?
  // Internal approval before sending: PENDING | APPROVED | REJECTED (null = not requested)
  approvalStatus      String?
  approvalRequestedAt DateTime?
  approvalRequestedBy String?
  approvalDecidedBy   String?
  approvalNote        String?
  // Hash of documents, recipients and fields at approval; edits afterwards need a new approval
  approvalFingerprint String?
  contract          ContractMeta?
  comments          Comment[]
  folderId          String?
  folder            Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Set when created through a self-serve signing form
  formId            String?
  // e-Stamp request (state, article, duty, parties) and the issued certificate
  estamp            Json?
  estampResult      Json?
  // Snapshot of the resolved compliance profile at send time
  policy            Json?
  reminderDays      Int            @default(2)
  expiresAt         DateTime?
  sentAt            DateTime?
  completedAt       DateTime?
  // Claim marker so only one worker seals a fully signed envelope; stale claims are retried
  finalizingAt      DateTime?
  voidReason        String?
  certificateKey    String?
  certificateSha256 String?
  certificateArchiveTimestampAt DateTime?
  certificatePriorSha256        String[]  @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  documents         Document[]
  recipients        Recipient[]
  fields            Field[]
  auditEvents       AuditEvent[]

  @@index([orgId, status])
}

model Document {
  id          String   @id @default(cuid())
  envelopeId  String
  envelope    Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name        String
  order       Int      @default(0)
  // Original (converted) PDF
  storageKey  String
  sha256      String
  pageCount   Int
  // [{ width, height }] in PDF points, used by the field editor
  pages       Json
  // Completed, sealed PDF
  // Copy that signer signatures are appended to (incremental updates); AES envelopes only
  workingKey  String?
  finalKey    String?
  finalSha256 String?
  // PAdES level reached (B-B, B-T, B-LT, B-LTA) and when the last archive timestamp was added
  ltvLevel           String?
  archiveTimestampAt DateTime?
  // Fingerprints of earlier sealed versions (before archive-timestamp renewals), still verifiable
  priorSha256        String[] @default([])
  // Revisions made during negotiation (1 = as first sent)
  version            Int      @default(1)
  versions           DocumentVersion[]
  createdAt   DateTime @default(now())
  fields      Field[]

  @@index([finalSha256])
}

enum RecipientRole {
  SIGNER
  // Reviews and approves without filling fields
  APPROVER
  CC
}

enum SignatureMethod {
  // Electronic signature (SES) sealed by the platform
  ELECTRONIC
  // Aadhaar eSign through a licensed eSign Service Provider (India, AES)
  AADHAAR_ESIGN
  // Signer's own Digital Signature Certificate on a USB token (AES)
  DSC
  // Qualified electronic signature through a QTSP's Cloud Signature Consortium API (eIDAS QES)
  QES
}

enum AuthMethod {
  EMAIL_OTP
  SMS_OTP
  WHATSAPP_OTP
  // Code shared with the signer out of band by the sender
  ACCESS_CODE
  // Identity established by the integrating app (embedded signing) or a host (in person)
  NONE
}

enum RecipientStatus {
  CREATED
  SENT
  VIEWED
  SIGNED
  DECLINED
}

model Recipient {
  id                   String          @id @default(cuid())
  envelopeId           String
  envelope             Envelope        @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name                 String
  email                String
  role                 RecipientRole   @default(SIGNER)
  routingOrder         Int             @default(1)
  // Language for emails and the signing page (BCP 47 code, e.g. "hi", "es")
  locale               String          @default("en")
  authMethod           AuthMethod      @default(EMAIL_OTP)
  signatureMethod      SignatureMethod @default(ELECTRONIC)
  // E.164 phone number for SMS / WhatsApp codes
  phone                String?
  accessCodeHash       String?
  // Embedded recipients sign inside the integrator's app; no emails are sent
  embedded             Boolean         @default(false)
  clientUserId         String?
  // In-person signing hosted by a user of the sending organisation
  hostUserId           String?
  // Bumped when the recipient is corrected or reassigned, invalidating old links
  tokenVersion         Int             @default(0)
  // One-time ticket that starts an embedded signing session (hashed, short-lived)
  embedTicketHash      String?         @unique
  embedTicketExpiresAt DateTime?
  embedReturnUrl       String?
  status               RecipientStatus @default(CREATED)
  // One-time passcode for signer authentication (hashed)
  otpHash              String?
  otpExpiresAt         DateTime?
  otpAttempts          Int             @default(0)
  // Set after OTP verification; ties the signing session to one browser
  signerSessionHash    String?
  verifiedAt           DateTime?
  viewedAt             DateTime?
  signedAt             DateTime?
  declinedAt           DateTime?
  declineReason        String?
  lastNotifiedAt       DateTime?
  signedIp             String?
  signedUserAgent      String?
  // Identity checks the signer must pass before signing: PAN, BANK, DIGILOCKER, VIDEO
  idChecks             String[]        @default([])
  // This signer witnesses another signer's signature (attests it was signed in their presence)
  witnessForId         String?
  // Random words the signer reads aloud in the video check (short-lived)
  videoChallenge       String?
  videoChallengeAt     DateTime?
  fields               Field[]
  kycChecks            KycCheck[]

  @@index([envelopeId])
}

/// Result of one identity check. Identifiers are stored masked; full numbers never are.
model KycCheck {
  id          String       @id @default(cuid())
  envelopeId  String
  recipientId String
  recipient   Recipient    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  kind        String
  provider    String
  status      KycStatus
  // 0-100 similarity between the verified name and the recipient's name
  nameMatch   Int?
  // Masked identifiers and returned attributes (registered name, bank, DOB year...)
  data        Json         @default("{}")
  // Video recording (VIDEO checks)
  storageKey  String?
  sha256      String?
  providerRef String?
  createdAt   DateTime     @default(now())

  @@index([recipientId])
  @@index([providerRef])
}

enum KycStatus {
  PENDING
  PASSED
  FAILED
}

/// eNACH (NPCI e-mandate) authorised by a signer through a MANDATE field.
model Mandate {
  id          String        @id @default(cuid())
  envelopeId  String
  recipientId String
  fieldId     String
  provider    String
  providerRef String?
  status      MandateStatus @default(PENDING)
  // Maximum debit per instalment, minor units
  maxAmount   Int
  currency    String        @default("INR")
  frequency   String
  startsOn    DateTime
  endsOn      DateTime
  // Unique Mandate Reference Number from NPCI, once registered
  umrn        String?
  bankName    String?
  // Masked account number
  account     String?
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([recipientId])
  @@index([providerRef])
}

enum MandateStatus {
  PENDING
  ACTIVE
  FAILED
}

enum FieldType {
  SIGNATURE
  INITIALS
  DATE_SIGNED
  NAME
  EMAIL
  TEXT
  CHECKBOX
  DROPDOWN
  RADIO
  NUMBER
  // Read-only value computed from NUMBER fields, e.g. "{Qty} * {Price}"
  FORMULA
  // Signer uploads a supporting file
  ATTACHMENT
  // Signer pays an amount before finishing
  PAYMENT
  // Signer authorises recurring debits (eNACH e-mandate, India)
  MANDATE
}

model Field {
  id          String    @id @default(cuid())
  envelopeId  String
  envelope    Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        FieldType
  // 0-based page index; position and size are fractions (0..1) of the page,
  // measured from the top-left corner.
  page        Int
  x           Float
  y           Float
  width       Float
  height      Float
  required    Boolean   @default(true)
  label       String?
  // Choices for DROPDOWN / RADIO
  options     String[]  @default([])
  // Expression for FORMULA fields, referencing NUMBER fields by label: "{Qty} * {Price}"
  formula     String?
  // PAYMENT fields: amount in minor units (paise, cents) and ISO currency
  amount      Int?
  currency    String?
  // Show this field only when another field has a value: { "fieldLabel": "Has guarantor", "equals": "true" }
  condition   Json?
  // Type-specific settings, e.g. MANDATE: { "frequency": "MONTHLY", "months": 12 }
  config      Json?
  // Filled in by the signer. Signatures/initials are PNG data URLs.
  value       String?

  @@index([envelopeId])
}

// ---------------------------------------------------------------------------
// Evidence
// ---------------------------------------------------------------------------

// Append-only, hash-chained log. hash = SHA-256(prevHash || canonical(event)).
model AuditEvent {
  id         String   @id @default(cuid())
  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  seq        Int
  type       String
  actor      Json
  data       Json
  ip         String?
  userAgent  String?
  createdAt  DateTime
  prevHash   String
  hash       String

  @@unique([envelopeId, seq])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model WebhookEndpoint {
  id         String            @id @default(cuid())
  orgId      String
  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  // Empty = all events
  events     String[]
  // json = signed JSON payload | slack / teams = chat message to an incoming-webhook URL
  format     String            @default("json")
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// Transactional outbox: rows are written in the same transaction as the
// state change, then delivered by the worker with retries.
model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        DeliveryStatus  @default(PENDING)
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastError     String?
  responseCode  Int?
  deliveredAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

// A reusable envelope: documents, placeholder roles and field layout.
// Recipients are bound to roles when an envelope is created from it.
model Template {
  id           String             @id @default(cuid())
  orgId        String
  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Shared with one department only (null = whole organisation)
  departmentId String?
  createdById  String
  name         String
  description  String?
  title        String
  message      String?
  jurisdiction String
  documentType String             @default("general")
  routing      RoutingMode        @default(SEQUENTIAL)
  reminderDays Int                @default(2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  documents    TemplateDocument[]
  roles        TemplateRole[]
  fields       TemplateField[]

  @@index([orgId])
}

model TemplateDocument {
  id         String          @id @default(cuid())
  templateId String
  template   Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int             @default(0)
  storageKey String
  sha256     String
  pageCount  Int
  pages      Json
  fields     TemplateField[]
}

model TemplateRole {
  id           String          @id @default(cuid())
  templateId   String
  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // e.g. "Employee", "Manager"
  name         String
  role         RecipientRole   @default(SIGNER)
  routingOrder Int             @default(1)
  fields       TemplateField[]
}

model TemplateField {
  id         String           @id @default(cuid())
  templateId String
  template   Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documentId String
  document   TemplateDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  roleId     String
  role       TemplateRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  type       FieldType
  page       Int
  x          Float
  y          Float
  width      Float
  height     Float
  required   Boolean          @default(true)
  label      String?
  options    String[]         @default([])
  formula    String?
  // PAYMENT fields: amount in minor units (paise, cents) and ISO currency
  amount     Int?
  currency   String?
  condition  Json?
}

// ---------------------------------------------------------------------------
// Website
// ---------------------------------------------------------------------------

// Demo / contact requests from the public website
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  role      String?
  country   String?
  interest  String
  message   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Files uploaded by signers through ATTACHMENT fields
model SignerAttachment {
  id          String   @id @default(cuid())
  envelopeId  String
  fieldId     String
  recipientId String
  name        String
  contentType String
  size        Int
  sha256      String
  storageKey  String
  createdAt   DateTime @default(now())

  @@index([envelopeId])
}

// Self-serve signing link: anyone with the link can sign a copy of a template
model SigningForm {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId String
  name       String
  slug       String       @unique
  active     Boolean      @default(true)
  maxUses    Int?
  uses       Int          @default(0)
  createdAt  DateTime     @default(now())
}

// One Aadhaar eSign / DSC request awaiting the signer's authentication
model EsignTransaction {
  id          String    @id
  envelopeId  String
  recipientId String
  provider    String
  status      String    @default("PENDING")
  // [{ documentId, preparedKey, contentsStart, contentsEnd, digest }]
  documents   Json
  // Provider flow state (CSC: stage, credential, certificate chain, hashes to sign)
  state       Json?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([recipientId])
}

// Cached AI outputs (summaries, reviews), keyed by content hash and options
model AiResult {
  id         String   @id @default(cuid())
  key        String   @unique
  kind       String
  envelopeId String
  data       Json
  createdAt  DateTime @default(now())

  @@index([envelopeId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// A signer's payment for a PAYMENT field
model Payment {
  id          String        @id @default(cuid())
  envelopeId  String
  recipientId String
  fieldId     String
  provider    String
  // Checkout session / payment link id at the provider
  providerRef String?
  amount      Int
  currency    String
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  // Provider's payment id once paid
  receipt     String?
  createdAt   DateTime      @default(now())

  @@index([recipientId])
  @@index([providerRef])
}

/// A started subscription purchase or plan change, completed by the provider's callback.
model BillingCheckout {
  id          String         @id @default(cuid())
  orgId       String
  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan        String
  interval    String
  seats       Int
  currency    String
  provider    String
  providerRef String?
  status      CheckoutStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  @@index([orgId])
}

enum CheckoutStatus {
  PENDING
  COMPLETED
  CANCELED
}

/// Tax invoice for one subscription charge. Amounts are in minor units.
model Invoice {
  id          String       @id @default(cuid())
  // Sequential invoice number (printed as INV-<year>-<seq>)
  seq         Int          @unique @default(autoincrement())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  description String
  plan        String
  interval    String
  seats       Int
  periodStart DateTime
  periodEnd   DateTime
  currency    String
  subtotal    Int
  // Tax rate in basis points (1800 = 18%)
  taxRate     Int          @default(0)
  taxLabel    String?
  tax         Int          @default(0)
  total       Int
  provider    String
  // Provider charge id; unique so repeated webhooks don't duplicate invoices
  providerRef String?      @unique
  // Seller and customer details as printed
  seller      Json
  billTo      Json
  paidAt      DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([orgId, createdAt])
}

/// A Word template with {{placeholders}} that generates documents.
model DocTemplate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  storageKey  String
  // Placeholder names found in the template, in order of appearance
  variables   String[]
  createdById String
  createdAt   DateTime     @default(now())

  @@index([orgId])
}

/// Key terms of an agreement for the contract repository.
model ContractMeta {
  envelopeId     String    @id
  envelope       Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  counterparty   String?
  // Minor units
  value          BigInt?
  currency       String?
  effectiveDate  DateTime?
  expiryDate     DateTime?
  renewalDate    DateTime?
  // Days of notice needed to cancel or renegotiate before the renewal/expiry date
  noticeDays     Int?
  autoRenews     Boolean   @default(false)
  tags           String[]  @default([])
  notes          String?
  // manual | ai (key terms extracted by the AI and not yet edited)
  source         String    @default("manual")
  reminderSentAt DateTime?
  updatedAt      DateTime  @updatedAt
}

/// A comment pinned to a place in a document (negotiation before signing).
model Comment {
  id         String    @id @default(cuid())
  envelopeId String
  envelope   Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  documentId String?
  page       Int?
  x          Float?
  y          Float?
  // user | recipient
  authorKind String
  authorId   String
  authorName String
  body       String
  parentId   String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([envelopeId])
}

/// Earlier versions of a document replaced during negotiation.
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  storageKey String
  sha256     String
  pageCount  Int
  createdAt  DateTime @default(now())

  @@index([documentId])
}

/// A department or workspace inside an organisation (e.g. "Sales", "HR").
model Department {
  id        String             @id @default(cuid())
  orgId     String
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime           @default(now())
  members   DepartmentMember[]
  envelopes Envelope[]

  @@unique([orgId, name])
}

model DepartmentMember {
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // member | manager (managers see every agreement in the department)
  role         String     @default("member")

  @@id([departmentId, userId])
  @@index([userId])
}

/// A help request from the in-app Help panel or the website.
model SupportRequest {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  email     String
  subject   String
  message   String
  page      String?
  createdAt DateTime @default(now())
}

/// A connected CRM (HubSpot private app token, Salesforce OAuth).
model CrmConnection {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // hubspot | salesforce
  provider       String
  // Sealed JSON: tokens (and refresh token / instance URL for Salesforce)
  credentialsEnc String
  // e.g. { "attachPdf": true }
  settings       Json         @default("{}")
  accountLabel   String?
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  events         CrmEvent[]

  @@unique([orgId, provider])
}

/// Outbox of agreement events to push to a CRM, delivered by the worker with retries.
model CrmEvent {
  id            String         @id @default(cuid())
  connectionId  String
  connection    CrmConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  event         String
  envelopeId    String
  payload       Json
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  createdAt     DateTime       @default(now())

  @@index([status, nextAttemptAt])
}

/// Every sign-in attempt, successful or not, for the platform console
/// (NuronixAI staff): logins per day, failed attempts, sign-in methods.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgId     String?
  email     String
  // password | mfa | sso | invite | register | office
  method    String
  success   Boolean
  // Why a failed attempt failed (bad_password, unknown_user, deactivated, sso_required, bad_code)
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// One row per user per day they used the app, for daily/weekly/monthly
/// active-user counts in the platform console (sessions only keep the latest).
model ActiveDay {
  userId String
  orgId  String
  day    DateTime @db.Date

  @@id([userId, day])
  @@index([day])
}

/// Console staff added from the platform console. People listed in
/// PLATFORM_ADMINS are owners and manage this list.
model PlatformAdmin {
  email     String   @id
  // admin (everything except managing staff) | viewer (read-only)
  role      String   @default("viewer")
  // Email alerts: failed payments, cancellations, new customers, sign-in attacks
  alerts    Boolean  @default(true)
  addedBy   String
  createdAt DateTime @default(now())
}

/// Refund or credit against a customer's billing, issued from the platform console.
model CreditNote {
  id          String       @id @default(cuid())
  // Printed as CN-<year>-<seq>
  seq         Int          @unique @default(autoincrement())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceId   String?
  // refund (money back to the card/account) | credit (towards future charges)
  kind        String
  // Minor units, tax included
  amount      Int
  currency    String
  reason      String
  provider    String?
  // Refund id at Stripe/Razorpay when the refund went through the provider
  providerRef String?
  createdBy   String
  createdAt   DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([invoiceId])
}
