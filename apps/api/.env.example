# --- Cell identity -------------------------------------------------------
# Each regional cell runs the same code with its own data. Data never leaves the cell.
CELL_REGION=local

# --- HTTP ----------------------------------------------------------------
PORT=4000
# Public URL of the web app (used in email links)
APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the API directly (the web app proxies /api)
CORS_ORIGINS=http://localhost:3000

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://docsign:docsign@localhost:5432/docsign?schema=public

# --- Object storage (any S3-compatible service; RustFS locally) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=docsign
S3_SECRET_KEY=docsign-secret
S3_BUCKET=docsign-documents

# --- Email ---------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="DocSign <no-reply@docsign.local>"

# --- Document conversion (Gotenberg) ------------------------------------
GOTENBERG_URL=http://localhost:3100

# --- Trust services ------------------------------------------------------
# RFC 3161 timestamp authority. Leave empty to produce PAdES-B-B (no timestamp).
TSA_URL=http://timestamp.digicert.com
# Where the local (development) key provider keeps the platform seal key.
# In production this is replaced by an HSM-backed key provider.
KEYS_DIR=.keys

# --- Secrets -------------------------------------------------------------
# Signs cookies and signing links. Change in any shared environment;
# rotating it invalidates outstanding signing links.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Background worker ---------------------------------------------------
# inline = run jobs inside the API process (single instance / development).
# off    = API only; run `npm run worker -w @docsign/api` as one separate process.
WORKER_MODE=inline

# --- Malware scanning (ClamAV clamd) -------------------------------------
# When set, every upload is scanned and rejected if infected or if the scanner
# is unreachable. Leave empty to skip scanning (development only).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Website ---------------------------------------------------------------
# Demo requests from the website contact form are emailed here.
SALES_EMAIL=sales@docsign.local

# --- SMS / WhatsApp one-time codes -----------------------------------------
# console = development (messages appear in Mailpit as sms-<number>@sms.local)
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
# Twilio (SMS and WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
# MSG91 (India SMS; needs a DLT template with an "otp" variable)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- India: Aadhaar eSign, DSC and e-stamping --------------------------------
# sandbox = built-in test ESP (NOT legally valid); production = licensed ESP
ESIGN_MODE=sandbox
ESIGN_ESP_URL=
ESIGN_ASP_ID=DOCSIGN-SANDBOX
# PEM of the ESP's response-signing certificate (production)
ESIGN_ESP_CERT=
# Trusted roots for DSC tokens (e.g. CCA India root and sub-CA PEMs)
DSC_TRUST_DIR=
# sandbox = specimen e-stamp certificates (not valid) | off
ESTAMP_PROVIDER=sandbox

# --- AI (Claude API) ----------------------------------------------------------
# Set to enable summaries, contract review, field detection and Q&A. Each
# organisation must also turn AI on under Settings → Organization.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
