# --- Cell identity -------------------------------------------------------
# Each regional cell runs the same code with its own data. Data never leaves the cell.
CELL_REGION=local

# --- HTTP ----------------------------------------------------------------
PORT=4000
# Public URL of the web app (used in email links)
APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the API directly (the web app proxies /api)
CORS_ORIGINS=http://localhost:3000

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://docsign:docsign@localhost:5432/docsign?schema=public

# --- Object storage (any S3-compatible service; RustFS locally) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=docsign
S3_SECRET_KEY=docsign-secret
S3_BUCKET=docsign-documents
# false for storage without Object Lock (e.g. Supabase Storage); sealed files are then not write-once
S3_OBJECT_LOCK=true
# s3 (default) | database: keep files in Postgres (hosts without object storage, e.g. Vercel + Neon)
STORAGE_DRIVER=s3

# --- Email ---------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
# Login for a real email service (e.g. Brevo: smtp-relay.brevo.com, port 587); leave empty locally
SMTP_USER=
SMTP_PASS=
# true only for port 465
SMTP_SECURE=false
MAIL_FROM="DocSign <no-reply@docsign.local>"

# --- Document conversion (Gotenberg) ------------------------------------
GOTENBERG_URL=http://localhost:3100

# --- Trust services ------------------------------------------------------
# RFC 3161 timestamp authority. Leave empty to produce PAdES-B-B (no timestamp).
TSA_URL=http://timestamp.digicert.com
# Archive timestamps (PAdES B-LTA) are renewed after this many days
LTA_RENEW_AFTER_DAYS=1825
# Where the local (development) key provider keeps the platform seal key.
# In production this is replaced by an HSM-backed key provider.
KEYS_DIR=.keys
# local = dev key on disk | aws-kms = HSM-backed key in AWS KMS (see docs/deployment.md)
SEAL_KEY_PROVIDER=local
SEAL_KMS_KEY_ID=
SEAL_KMS_REGION=ap-south-1
SEAL_CERT_CHAIN_PATH=

# --- Secrets -------------------------------------------------------------
# Signs cookies and signing links. Change in any shared environment;
# rotating it invalidates outstanding signing links.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Background worker ---------------------------------------------------
# inline = run jobs inside the API process (single instance / development).
# off    = API only; run `npm run worker -w @docsign/api` as one separate process.
WORKER_MODE=inline

# --- Malware scanning (ClamAV clamd) -------------------------------------
# When set, every upload is scanned and rejected if infected or if the scanner
# is unreachable. Leave empty to skip scanning (development only).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Website ---------------------------------------------------------------
# Demo requests from the website contact form are emailed here.
SALES_EMAIL=sales@docsign.local

# --- SMS / WhatsApp one-time codes -----------------------------------------
# console = development (messages appear in Mailpit as sms-<number>@sms.local)
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
# Twilio (SMS and WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
# MSG91 (India SMS; needs a DLT template with an "otp" variable)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- India: Aadhaar eSign, DSC and e-stamping --------------------------------
# sandbox = built-in test ESP (NOT legally valid); production = licensed ESP
ESIGN_MODE=sandbox
ESIGN_ESP_URL=
ESIGN_ASP_ID=DOCSIGN-SANDBOX
# PEM of the ESP's response-signing certificate (production)
ESIGN_ESP_CERT=
# Trusted roots for DSC tokens (e.g. CCA India root and sub-CA PEMs)
DSC_TRUST_DIR=
# sandbox = specimen e-stamp certificates (not valid) | off
ESTAMP_PROVIDER=sandbox

# --- AI (Claude API) ----------------------------------------------------------
# Set to enable summaries, contract review, field detection and Q&A. Each
# organisation must also turn AI on under Settings → Organization.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Payments at signing --------------------------------------------------------
# sandbox = built-in test checkout | stripe | razorpay
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
# Stripe webhook endpoint: <APP_URL>/api/v1/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Subscription billing --------------------------------------------------------
# sandbox = built-in test checkout | stripe | razorpay (uses the keys above)
# NuronixAI staff who can open the platform console at /admin (comma-separated emails;
# each must confirm their email and turn on two-factor authentication)
PLATFORM_ADMINS=

BILLING_PROVIDER=sandbox
# Stripe endpoint: <APP_URL>/api/v1/billing/stripe/webhook
#   events: invoice.paid, invoice.payment_failed, customer.subscription.updated/deleted
STRIPE_BILLING_WEBHOOK_SECRET=
# Razorpay webhook: <APP_URL>/api/v1/billing/razorpay/webhook
#   events: subscription.charged, subscription.pending, subscription.halted, subscription.cancelled
RAZORPAY_WEBHOOK_SECRET=
# GST on INR invoices (percent). Set 0 if the business is not GST-registered.
BILLING_GST_RATE=18
# Printed on invoices
BILLING_SELLER_NAME="NuronixAI"
BILLING_SELLER_ADDRESS=
BILLING_SELLER_GSTIN=

# --- Cloud storage pickers (public client identifiers; empty hides the button) ---
# Google Picker: OAuth web client ID, an API key with the Picker API, and the project number
GOOGLE_PICKER_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
# Dropbox Chooser app key (add your domain under "Chooser / Saver domains")
DROPBOX_APP_KEY=
# OneDrive picker: Microsoft Entra app (SPA) with redirect URI <APP_URL>/onedrive-picker
ONEDRIVE_CLIENT_ID=

# --- Signer identity checks (India) ----------------------------------------------
# sandbox = built-in answers (PAN or account numbers containing 0000 fail) | cashfree
KYC_PROVIDER=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# https://api.cashfree.com/verification in production
CASHFREE_VERIFICATION_URL=https://sandbox.cashfree.com/verification
# sandbox = built-in consent page | production = DigiLocker partner credentials
#   redirect URI to register: <APP_URL>/api/v1/kyc/digilocker/callback
DIGILOCKER_MODE=sandbox
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_BASE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2

# --- eNACH e-mandates --------------------------------------------------------------
# sandbox = built-in bank approval page | razorpay (registration links; uses the Razorpay keys)
#   Razorpay webhook: <APP_URL>/api/v1/enach/razorpay/webhook (event invoice.paid), secret RAZORPAY_WEBHOOK_SECRET
ENACH_PROVIDER=sandbox

# --- CRM -----------------------------------------------------------------------------
# HubSpot needs no server setting (each organisation pastes a private app token).
# Salesforce: a connected app with OAuth scopes "api refresh_token offline_access" and
#   callback URL <APP_URL>/api/v1/integrations/salesforce/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# --- Help and support -----------------------------------------------------------------
SUPPORT_EMAIL=support@docsign.local

# --- Qualified electronic signatures (eIDAS QES via the CSC API v2) --------------------
# sandbox = built-in test trust service (NOT qualified) | production = a QTSP's CSC API
CSC_MODE=sandbox
CSC_API_URL=
CSC_OAUTH_URL=
CSC_CLIENT_ID=
CSC_CLIENT_SECRET=
#   OAuth redirect URI to register with the QTSP: <APP_URL>/api/v1/qes/callback
